// Last to Leave — Firestore security rules.
// Paste this whole file into Firebase console -> Firestore Database -> Rules, then Publish.
// The web config in js/core/firebaseConfig.js is public; THESE rules are what protect the data.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(n) { return n is string && n.matches('^[A-Za-z0-9_]{3,16}$'); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function namePath(lower) { return /databases/$(database)/documents/usernames/$(lower); }

    function validScore(d) {
      return d.keys().hasOnly(['gameId', 'variant', 'score', 'maxScore', 'passed', 'playedAt'])
        && d.gameId is string && d.gameId.size() <= 40
        && d.variant is string && d.variant.size() <= 40
        && d.score is number && d.score >= 0 && d.score <= 100000
        && (d.maxScore == null || d.maxScore is number)
        && d.passed is bool
        && d.playedAt is string && d.playedAt.size() <= 40;
    }

    // usernames/{lowercase name} = { uid }. One per name, claimed once, never changed.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(userPath(request.auth.uid))                       // one username per account
        && getAfter(userPath(request.auth.uid)).data.usernameLower == name;
      allow update, delete: if false;
    }

    // users/{uid}: the public profile. Only the username, nothing from Google.
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt'])
        && validName(request.resource.data.username)
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.createdAt == request.time
        && getAfter(namePath(request.resource.data.usernameLower)).data.uid == uid;
      allow update, delete: if false;

      // best score per game:variant (public, for leaderboards)
      match /bests/{key} {
        allow read: if true;
        allow create, update: if isOwner(uid)
          && validScore(request.resource.data)
          && key == request.resource.data.gameId + ':' + request.resource.data.variant;
        allow delete: if false;
      }

      // every game played (private to the player)
      match /history/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validScore(request.resource.data);
        allow update, delete: if false;
      }
    }

    // leaderboards: boards/{period~kind}/entries/{uid} = { uid, username, value, updatedAt }
    // period = 'all' or 'w' + Monday's date. Win counters only go up by exactly 1;
    // endless bests only go up (and stay under a sanity cap). Online boards aren't writable yet.
    function boardKind(board) { return board.split('~')[1]; }
    function isEndless(board) { return boardKind(board).matches('^endless-.*'); }
    function validEntry(board, uid) {
      return isOwner(uid)
        && board.matches('^(all|w[0-9]{4}-[0-9]{2}-[0-9]{2})~(endless-catch|endless-bullet|endless-cup|comp-wins|comp-wins-offline|mini-wins|mini-wins-offline)$')
        && request.resource.data.keys().hasOnly(['uid', 'username', 'value', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.username == get(userPath(uid)).data.username
        && request.resource.data.value is int
        && request.resource.data.updatedAt == request.time;
    }
    match /boards/{board}/entries/{uid} {
      allow read: if true;
      allow create: if validEntry(board, uid)
        && (isEndless(board)
          ? request.resource.data.value >= 0 && request.resource.data.value <= 5000
          : request.resource.data.value == 1);
      allow update: if validEntry(board, uid)
        && (isEndless(board)
          ? request.resource.data.value > resource.data.value && request.resource.data.value <= 5000
          : request.resource.data.value == resource.data.value + 1);
      allow delete: if false;
    }

    // everything else: closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
